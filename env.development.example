# Copy to .env.development for docker-compose.dev.yml.
# Every key below is required at boot by config/initializers/figaro.rb.
# Dummy values are enough to boot the app; ask the team for real ones to use
# the integrations (scraping via Hypatia, email, LLM categorization, image search).

# Hosts (add them to /etc/hosts pointing to 127.0.0.1)
FACT_CHECK_INSIGHTS_HOST=www.factcheckinsights.local
MEDIA_VAULT_HOST=vault.factcheckinsights.local
PUBLIC_LINK_HOST=public-vault.factcheckinsights.local
# WebAuthn relying party id: the domain shared by the hosts above
AUTH_BASE_HOST=factcheckinsights.local

# Generate with `docker compose -f docker-compose.dev.yml run --rm web bin/rails secret`
KEY_ENCRYPTION_SALT=change-me
DEVISE_JWT_SECRET_KEY=change-me

# Scraper (Hypatia)
HYPATIA_SERVER_URL=http://localhost:9999/scrape.json
HYPATIA_AUTH_KEY=change-me

# Email (Mailgun)
MAIL_DOMAIN=mail.factcheckinsights.local
MAILGUN_API_KEY=change-me

# reCAPTCHA Enterprise
RECAPTCHA_SITE_KEY=sitekey
RECAPTCHA_PROJECT_ID=projectid

# LLM categorization (OpenAI-compatible endpoint) and Langfuse prompt management
LLM_API_KEY=change-me
LLM_ENDPOINT=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=change-me
LANGFUSE_SECRET_KEY=change-me

# Google Fact Check Tools API (image search)
FACTCHECK_TOOLS_API_KEY=change-me

# Chrome extension
CHROME_EXTENSION_ID=change-me

# Silences libvips warnings in the logs
VIPS_WARNING=0

# Uploads are stored on local disk (public/uploads) by default.
# Set to "true" to use S3 instead, which then requires the AWS_* and S3_ENDPOINT keys.
USE_S3_DEV_TEST=false
