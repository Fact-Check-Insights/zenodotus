<tr id="<%= dom_id(api_key) %>">
  <td class="px-4 py-2 whitespace-nowrap font-mono text-gray-900"><%= api_key.key_prefix.present? ? "#{api_key.key_prefix}…" : "—" %></td>
  <td class="px-4 py-2 font-medium text-gray-900"><%= api_key.description %></td>
  <td class="px-4 py-2 text-gray-700"><%= api_key.user.name %> (<%= api_key.user.email %>)</td>
  <td class="px-4 py-2 whitespace-nowrap text-gray-700"><%= l(api_key.created_at, format: :short) %></td>
  <td class="px-4 py-2 whitespace-nowrap text-gray-700"><%= api_key.last_used.present? ? l(api_key.last_used) : t("api_keys.never_used") %></td>
  <td class="px-4 py-2 whitespace-nowrap text-gray-700"><%= t("api_keys.statuses.#{api_key.active ? "active" : "inactive"}") %></td>
  <td class="px-4 py-2 whitespace-nowrap">
    <%= link_to t("api_keys.edit"), edit_admin_api_key_path(api_key) %>
    &middot;
    <%= button_to t("api_keys.delete"), admin_api_key_path(api_key), method: :delete, form: { class: "inline", data: { turbo_confirm: t("api_keys.delete_confirm") } }, class: "text-red-700" %>
  </td>
</tr>
