<% @title_tag = t("api_keys.title") %>
<% @page_id = "api_keys" %>

<div class="mx-auto max-w-screen-xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl"><%= t("api_keys.title") %></h1>
    <%= link_to t("api_keys.new"), new_admin_api_key_path, class: "inline-block rounded-sm bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700" %>
  </div>

  <% if @api_keys.empty? %>
    <p class="mt-6 text-sm text-gray-600"><%= t("api_keys.no_api_keys") %></p>
  <% else %>
    <div class="mt-6 overflow-x-auto">
      <table id="api-keys-table" class="min-w-full divide-y-2 divide-gray-200 text-sm">
        <thead>
          <tr>
            <th class="px-4 py-2 font-semibold text-gray-900 text-left"><%= t("api_keys.columns.key") %></th>
            <th class="px-4 py-2 font-semibold text-gray-900 text-left"><%= t("api_keys.columns.description") %></th>
            <th class="px-4 py-2 font-semibold text-gray-900 text-left"><%= t("api_keys.columns.user") %></th>
            <th class="px-4 py-2 font-semibold text-gray-900 text-left"><%= t("api_keys.columns.created_at") %></th>
            <th class="px-4 py-2 font-semibold text-gray-900 text-left"><%= t("api_keys.columns.last_used") %></th>
            <th class="px-4 py-2 font-semibold text-gray-900 text-left"><%= t("api_keys.columns.status") %></th>
            <th class="px-4 py-2 font-semibold text-gray-900 text-left"><%= t("api_keys.columns.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @api_keys.each do |api_key| %>
            <%= render partial: "api_key", locals: { api_key: api_key } %>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render partial: "media_vault/archive/paginator", locals: { item_name: t("api_keys.api_key") } %>
  <% end %>
</div>
