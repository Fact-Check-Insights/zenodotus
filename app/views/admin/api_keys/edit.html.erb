<% @title_tag = t("api_keys.edit_title") %>
<% @page_id = "api_keys" %>

<div class="mx-auto max-w-screen-md px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl"><%= t("api_keys.edit_title") %></h1>

  <dl class="mt-6 text-sm">
    <dt class="font-medium text-gray-900"><%= t("api_keys.columns.key") %></dt>
    <dd class="font-mono text-gray-700"><%= @api_key.key_prefix.present? ? "#{@api_key.key_prefix}…" : "—" %></dd>
    <dt class="mt-2 font-medium text-gray-900"><%= t("api_keys.columns.user") %></dt>
    <dd class="text-gray-700"><%= @api_key.user.name %> (<%= @api_key.user.email %>)</dd>
    <dt class="mt-2 font-medium text-gray-900"><%= t("api_keys.columns.created_at") %></dt>
    <dd class="text-gray-700"><%= l(@api_key.created_at, format: :short) %></dd>
  </dl>

  <%= render "form", api_key: @api_key, users: [] %>
</div>
