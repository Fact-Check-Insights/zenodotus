<% @title_tag = "Edit #{@organization.name}" %>
<% @page_id = "organizations" %>

<div class="mx-auto max-w-screen-md px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">Edit Organization</h1>
  <%= render "form", organization: @organization %>

  <div class="mt-12 border-t border-gray-200 pt-6">
    <%= button_to "Delete organization", admin_organization_path(@organization), method: :delete, form: { data: { turbo_confirm: "Delete #{@organization.name}? Its users will be kept, without an organization." } }, class: "inline-block rounded-sm bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700" %>
  </div>
</div>
